# Postgres connection string. Neon works out of the box (the app uses its serverless
# driver); Vercel's Neon integration sets this for you. POSTGRES_URL is read as a fallback.
DATABASE_URL=

# The one password that opens the workspace.
NOTES_PASSWORD=

# Signs the login cookie. 32+ random characters:
#   openssl rand -base64 32
NOTES_SESSION_SECRET=

# Optional. A static bearer token for MCP clients you configure by hand (Claude Code).
# At least 32 characters. claude.ai and other OAuth clients don't need it.
NOTES_MCP_TOKEN=
